    directory: "image"
  - path: ../image/Create_NCP.png
    directory: "image"
  - path: ../image/Create_ZR_App.png
    directory: "image"
  - path: ../image/Docker_Warning.png
    directory: "image"
  - path: ../image/HA_Webpage.png
    directory: "image"
  - path: ../image/Launcher.png
    directory: "image"
  - path: ../image/Project_Wizard.png
    directory: "image"
  - path: ../image/Serial_Port_Selection.png
    directory: "image"
  - path: ../image/Startup_Page.png
    directory: "image"
  - path: ../image/System_Overview.png
    directory: "image"
  - path: ../image/URL.png
    directory: "image"
  - path: ../image/Welcome_Screen.png
    directory: "image"
  - path: ../image/ZHA_Commissioning_Start.png
    directory: "image"
  - path: ../image/ZHA_Coordinator_Control_Panel.png
    directory: "image"
  - path: ../image/ZHA_Current_Unit_Modify.png
    directory: "image"
  - path: ../image/ZHA_Device_Checking.png
    directory: "image"
  - path: ../image/ZHA_Device_Is_Connected_To_The_Network.png
