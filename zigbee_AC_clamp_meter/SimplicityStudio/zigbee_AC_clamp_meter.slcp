# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: zigbee_AC_clamp_meter
label: Zigbee - AC Clamp Meter Example
author: Silicon Laboratories, Inc.
description: This example shows how to use AC Current click sensor (MIKROE) with the EFR32xG24 Dev Kit Board and implement it in your Zigbee project with Simplciity Studio. This application demonstrates how to measure AC parameters such current, power, consumption using the AC Current click sensor connected to the EFR32xG24 Dev Kit Board. The measured and calculated values are then reported to a connected Zigbee Coordinator device.
category: Zigbee Application

filter:
- name: Device Type
  value: [SoC]
- name: Project Difficulty
  value: [Advanced]
- name: Wireless Technology
  value: [Zigbee]

package: Zigbee
quality: experimental

readme:
- path: ../README.md

source:
- path: ../src/main.c
- path: ../src/app.c

include:
  - path: ../inc
    file_list:
      - path: app.h

component:
- id: sl_main
- id: accurrent
  from: third_party_hw_drivers 
- id: cli
  instance: [example] 
- id: clock_manager
- id: iostream_recommended_console
- id: simple_button
  instance: [btn0, btn1]
- id: simple_led
  instance: [led0]
- id: toolchain_gcc_lto
- id: zigbee_application_bootloader
- id: zigbee_basic
- id: zigbee_core_cli
- id: zigbee_counters
- id: zigbee_debug_basic
- id: zigbee_debug_print
- id: zigbee_find_and_bind_initiator
- id: zigbee_network_steering
- id: zigbee_pro_stack
- id: zigbee_reporting
- id: zigbee_scan_dispatch
- id: zigbee_simple_metering_server
- id: zigbee_source_route
- id: zigbee_update_tc_link_key
- id: zigbee_zcl_cli
- id: zigbee_zcl_framework_core
- id: zigbee_zll_identify_server

config_file:
- path: ../config/zcl/zcl_config.zap
  directory: zcl

